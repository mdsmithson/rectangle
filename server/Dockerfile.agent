FROM python:3.15.2-alpine3.24
RUN apk add --no-cache nodejs npm gcompat libstdc++ bash git ripgrep ca-certificates \
    tigervnc openbox xterm socat font-dejavu xclip xdotool vim \
    elixir erlang-dev cargo rust curl ruby ruby-dev ruby-bundler \
    build-base linux-headers pkgconf openssl-dev \
    && addgroup -g 10001 rectangle && adduser -D -H -u 10001 -G rectangle rectangle \
    && mkdir -p /agent/home/.local && chown -R 10001:10001 /agent/home \
    && npm install --global --no-audit --no-fund freebuff@0.2.35 \
    && case "$(apk --print-arch)" in x86_64) export FREEBUFF_BINARY_TARGET=linux-x64-baseline ;; esac \
    && freebuff --version \
    && mkdir -p /opt/rectangle/freebuff \
    && cp /root/.config/manicode/freebuff /root/.config/manicode/tree-sitter.wasm /opt/rectangle/freebuff/ \
    && chmod 0555 /opt/rectangle/freebuff/freebuff \
    && rm -rf /root/.config/manicode \
    && npm cache clean --force
COPY --chmod=0555 agent-entrypoint /opt/rectangle/agent-entrypoint
COPY clipboard-stream.py memory-stream.py /opt/rectangle/
ENV HOME=/tmp/home DISPLAY=:99 LANG=C.UTF-8 TERM=xterm-256color
USER 10001:10001
ENTRYPOINT ["/opt/rectangle/agent-entrypoint"]
