FROM debian:13-slim
ARG TARGETARCH
RUN test "${TARGETARCH:-amd64}" = amd64 \
    && dpkg --add-architecture i386 \
    && sed -i 's/^Components: main$/Components: main contrib/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        bash build-essential ca-certificates cargo curl elixir erlang-dev firefox-esr \
        git libssl-dev nodejs npm openssh-client pkg-config python3 python3-pip python3-venv \
        ripgrep ruby ruby-bundler ruby-dev rustc vim \
        dbus-x11 fonts-dejavu-core openbox socat tigervnc-standalone-server x11-utils xclip xdotool xterm \
        xfce4-session xfce4-panel xfce4-settings xfdesktop4 xfwm4 thunar xfce4-terminal \
        pulseaudio pulseaudio-utils xdg-user-dirs xdg-utils \
        wine wine64 wine64-preloader wine32:i386 wine32-preloader:i386 fonts-wine winetricks cabextract p7zip-full unzip zenity \
        libgl1-mesa-dri libgl1-mesa-dri:i386 mesa-vulkan-drivers mesa-vulkan-drivers:i386 \
        libvulkan1 libvulkan1:i386 libpulse0:i386 libasound2-plugins libasound2-plugins:i386 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 rectangle \
    && useradd -u 10001 -g rectangle -d /agent/home -s /bin/bash rectangle \
    && mkdir -p /agent/home/.local /opt/rectangle/freebuff \
    && chown -R 10001:10001 /agent/home \
    && ln -s /usr/bin/Xtigervnc /usr/local/bin/Xvnc \
    && npm install --global --no-audit --no-fund freebuff@0.2.35 \
    && FREEBUFF_BINARY_TARGET=linux-x64-baseline freebuff --version \
    && cp /root/.config/manicode/freebuff /root/.config/manicode/tree-sitter.wasm /opt/rectangle/freebuff/ \
    && chmod 0555 /opt/rectangle/freebuff/freebuff \
    && rm -rf /root/.config/manicode \
    && npm cache clean --force
COPY --chmod=0555 application-entrypoint /opt/rectangle/agent-entrypoint
COPY --chmod=0555 agent-browser audio-stream /opt/rectangle/
COPY --chmod=0444 agent-browser.desktop /usr/share/applications/rectangle-agent-browser.desktop
COPY --chmod=0444 application-wine.desktop /usr/share/applications/rectangle-wine.desktop
COPY --chmod=0444 application-mimeapps.list /etc/xdg/mimeapps.list
COPY --chmod=0444 clipboard-stream.py memory-stream.py /opt/rectangle/
ENV HOME=/agent/home DISPLAY=:99 LANG=C.UTF-8 TERM=xterm-256color BROWSER=/opt/rectangle/agent-browser PULSE_SERVER=unix:/tmp/rectangle-pulse/native XDG_RUNTIME_DIR=/run/user/10001
USER 10001:10001
ENTRYPOINT ["/opt/rectangle/agent-entrypoint"]
