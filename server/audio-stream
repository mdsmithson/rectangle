#!/bin/sh
set -eu
export PULSE_SERVER=unix:/tmp/rectangle-pulse/native
pactl info >/dev/null 2>&1 || exit 1
printf 'RECTPCM1'
parec --raw --format=s16le --rate=48000 --channels=2 --latency-msec=60 \
    --device=rectangle.monitor </dev/null &
player=$!
trap 'kill "$player" 2>/dev/null || :; wait "$player" 2>/dev/null || :' EXIT
trap 'exit 0' HUP INT TERM
# The client holds stdin open. Closing its SSH channel stops this capture.
cat >/dev/null
