FROM debian:13-slim
ARG TARGETARCH
ARG CHATGPT_DEB_URL=https://persistent.oaistatic.com/codex-app-prod/linux/deb/latest/chatgpt_amd64.deb
ARG CHATGPT_DEB_SHA256=830e251b6ca4ad45fe6904127a790e8f00f7c26ed4c8039473f7323c7c4e2692
RUN test "${TARGETARCH:-amd64}" = amd64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
        python3 git openssh-client bash ripgrep nodejs npm \
        tigervnc-standalone-server openbox xterm socat fonts-dejavu-core \
        xclip xdotool vim dbus-x11 firefox-esr \
    && curl --proto '=https' --tlsv1.2 -fL "$CHATGPT_DEB_URL" -o /tmp/chatgpt.deb \
    && echo "$CHATGPT_DEB_SHA256  /tmp/chatgpt.deb" | sha256sum -c - \
    && apt-get install -y --no-install-recommends /tmp/chatgpt.deb \
    && rm -f /tmp/chatgpt.deb \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 rectangle \
    && useradd -u 10001 -g rectangle -d /agent/home -s /bin/sh rectangle \
    && mkdir -p /agent/home/.local \
    && chown -R 10001:10001 /agent/home \
    && ln -s /usr/bin/Xtigervnc /usr/local/bin/Xvnc
COPY --chmod=0555 codex-entrypoint /opt/rectangle/agent-entrypoint
COPY --chmod=0555 agent-browser /opt/rectangle/agent-browser
COPY --chmod=0444 agent-browser.desktop /usr/share/applications/rectangle-agent-browser.desktop
COPY --chmod=0444 agent-mimeapps.list /etc/xdg/mimeapps.list
COPY --chmod=0444 clipboard-stream.py memory-stream.py /opt/rectangle/
RUN ln -s /usr/lib/chatgpt/resources/codex /usr/local/bin/codex
ENV HOME=/agent/home DISPLAY=:99 LANG=C.UTF-8 TERM=xterm-256color RECTANGLE_AGENT_FLAVOR=codex BROWSER=/opt/rectangle/agent-browser
USER 10001:10001
ENTRYPOINT ["/opt/rectangle/agent-entrypoint"]
