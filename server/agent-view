#!/bin/sh
set -eu
umask 077
mode=$1
case $mode in
    sh) display=100; title='SH Terminal'; program=/bin/sh ;;
    freebuff) display=101; title=Freebuff; program=/opt/rectangle/freebuff/freebuff ;;
    codex) display=101; title='ChatGPT Codex'; program=/usr/lib/chatgpt/codex-launcher ;;
    browser)
        display=128; title=Browser; program=/opt/rectangle/agent-browser
        [ -x "$program" ] || { echo 'Save and reopen this Agent with the updated image to use Open Browser.' >&2; exit 1; } ;;
    files) display=102; program= ;;
    edit|edit10[3-9]|edit11[0-9]|edit12[0-7])
        command -v vim >/dev/null || { echo 'Vim is missing. Reopen the Agent with the updated image.' >&2; exit 1; }
        display=${mode#edit}; display=${display:-103}; title='SH Terminal · Vim'; program=python3 ;;
    *) exit 1 ;;
esac
# Display startup needs space for its PID lock and Unix sockets. Diagnose
# exhaustion before Xvnc reports a misleading lock-file failure.
python3 -I -c '
import os, sys
space = os.statvfs("/tmp")
if space.f_bavail * space.f_frsize < 8 * 1024 * 1024 or not space.f_favail:
    sys.exit("The Agent temporary storage (/tmp) is full or nearly full. Free temporary files from SH Terminal, then reopen this view. Files in /agent/home are separate.")
'
lock_name=$mode
if [ "$display" = 103 ]; then lock_name=edit; fi
lock="/tmp/rectangle-view-$lock_name"
mkdir "$lock" || { echo 'This terminal view is already open.' >&2; exit 1; }
xvnc= manager= terminal= bus=
cleanup() {
    for pid in "$terminal" "$manager" "$xvnc" "$bus"; do
        if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || :; fi
    done
    wait || :
    rm -f -- "$lock/rfb"
    rm -f -- "$lock/openbox.xml"
    rm -f -- "$lock/bus"
    rmdir "$lock"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
export DISPLAY=:$display
geometry=1024x640
if [ "$mode" = codex ] || [ "$mode" = browser ]; then geometry=2560x1440; fi
Xvnc "$DISPLAY" -geometry "$geometry" -depth 24 -nolisten tcp -localhost \
    -rfbport -1 -rfbunixpath "$lock/rfb" -SecurityTypes None -AcceptSetDesktopSize=1 \
    -AcceptCutText=0 -SendCutText=0 </dev/null >&2 &
xvnc=$!
for i in $(seq 1 60); do
    [ ! -S "/tmp/.X11-unix/X$display" ] || break
    kill -0 "$xvnc" || exit 1
    sleep .1
done
[ -S "/tmp/.X11-unix/X$display" ]
if [ -n "$program" ]; then
    if [ "$mode" = browser ]; then
        cat > "$lock/openbox.xml" <<'XML'
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <applications>
    <application type="normal"><maximized>yes</maximized><decor>no</decor></application>
    <application type="dialog"><position force="no"><x>center</x><y>center</y></position></application>
  </applications>
</openbox_config>
XML
        openbox --config-file "$lock/openbox.xml" </dev/null >&2 &
    else
        openbox --config-file /tmp/agent-openbox.xml </dev/null >&2 &
    fi
    manager=$!
    cd "$HOME/workspace"
    if [ "$program" = python3 ]; then
        set -- python3 -I -c "$2" edit "$3" "$4"
    else
        set -- "$program"
    fi
    if [ "$mode" = codex ]; then
        dbus-run-session -- "$program" --ozone-platform=x11 --disable-gpu </dev/null >&2 &
    elif [ "$mode" = browser ]; then
        dbus-daemon --session --address="unix:path=$lock/bus" --nofork --nopidfile </dev/null >&2 &
        bus=$!
        for i in $(seq 1 60); do
            [ ! -S "$lock/bus" ] || break
            kill -0 "$bus" 2>/dev/null || exit 1
            sleep .1
        done
        [ -S "$lock/bus" ]
        "$program" --new-window about:blank </dev/null >&2 &
    else
    xterm -fullscreen -fa 'DejaVu Sans Mono' -fs 12 -bg '#0d121a' -fg '#e1e9f0' \
        -xrm 'XTerm*VT100.translations: #override Ctrl <Key>v: insert-selection(CLIPBOARD)' \
        -title "$title" -hold -e "$@" </dev/null >&2 &
    fi
    terminal=$!
fi
socat -t 1 STDIO "UNIX-CONNECT:$lock/rfb,retry=20,interval=1"
